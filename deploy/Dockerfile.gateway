# 基础构建阶段
FROM maven:3.9-eclipse-temurin-17 AS builder

WORKDIR /app

# 复制 pom 文件
COPY pom.xml .
COPY rental-common/pom.xml rental-common/
COPY rental-gateway/pom.xml rental-gateway/

# 下载依赖
RUN mvn dependency:go-offline -B

# 复制源码
COPY . .

# 构建项目
RUN mvn clean package -DskipTests -pl rental-gateway -am

# 运行阶段
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# 复制构建产物
COPY --from=builder /app/rental-gateway/target/*.jar app.jar

# 暴露端口
EXPOSE 8080

# 启动应用
ENTRYPOINT ["java", "-jar", "app.jar"]
