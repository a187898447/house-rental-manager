# 基础构建阶段
FROM maven:3.9-eclipse-temurin-17 AS builder

WORKDIR /app

COPY pom.xml .
COPY rental-common/pom.xml rental-common/
COPY rental-bill/pom.xml rental-bill/

RUN mvn dependency:go-offline -B

COPY . .

RUN mvn clean package -DskipTests -pl rental-bill -am

# 运行阶段
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

COPY --from=builder /app/rental-bill/target/*.jar app.jar

EXPOSE 8083

ENTRYPOINT ["java", "-jar", "app.jar"]
