<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rental.user.mapper.TenantMapper">

    <resultMap id="BaseResultMap" type="com.rental.user.entity.Tenant">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="property_id" property="propertyId"/>
        <result column="name" property="name"/>
        <result column="id_card" property="idCard"/>
        <result column="phone" property="phone"/>
        <result column="check_in_date" property="checkInDate"/>
        <result column="check_out_date" property="checkOutDate"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByPropertyId" resultMap="BaseResultMap">
        SELECT * FROM t_tenant
        WHERE property_id = #{propertyId}
        <if test="status != null">
            AND status = #{status}
        </if>
        ORDER BY create_time DESC
    </select>

    <select id="selectByLandlordId" resultMap="BaseResultMap">
        SELECT t.* FROM t_tenant t
        INNER JOIN t_property p ON t.property_id = p.id
        WHERE p.create_by = #{landlordId}
        <if test="status != null">
            AND t.status = #{status}
        </if>
        ORDER BY t.create_time DESC
    </select>
</mapper>
