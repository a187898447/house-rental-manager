<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!-- 阿里巴巴Java开发手册Checkstyle规则 -->
<!-- 基于阿里巴巴P3C规范 -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="FileLength"><property name="max" value="2000"/></module>
    <module name="NewlineAtEndOfFile"><property name="lineSeparator" value="lf"/></module>

    <module name="TreeWalker">
        <!-- 命名规范 -->
        <module name="AbbreviationAsWordInNameCheck">
            <property name="ignoreFinal" value="false"/>
            <property name="allowedAbbreviationLength" value="1"/>
        </module>
        <module name="PackageNameCheck"><property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/></module>
        <module name="TypeNameCheck"/>
        <module name="MethodNameCheck"/>
        <module name="MemberNameCheck"><property name="format" value="^[a-z][a-z0-9]*$"/></module>
        <module name="ParameterNameCheck"><property name="format" value="^[a-z][a-z0-9]*$"/></module>
        <module name="LocalVariableNameCheck"><property name="format" value="^[a-z][a-z0-9]*$"/></module>
        <module name="ConstantNameCheck"><property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/></module>

        <!-- 行长度 -->
        <module name="LineLength">
            <property name="max" value="120"/>
            <property name="ignorePattern" value="^package.*|^import.*|http://|https://"/>
        </module>

        <!-- 缩进 -->
        <module name="IndentationCheck">
            <property name="basicOffset" value="4"/>
            <property name="caseIndent" value="4"/>
        </module>

        <!-- 多余空白 -->
        <module name="RegexpSingleline"><property name="format" value="\s+$"/><property name="message" value="行尾不能有空格"/></module>

        <!-- 大括号 -->
        <module name="LeftCurlyCheck"/>
        <module name="RightCurlyCheck"/>
        <module name="NeedBracesCheck"/>

        <!-- 注解 -->
        <module name="AnnotationLocationCheck">
            <property name="allowSamelineSingleParameterlessAnnotation" value="true"/>
        </module>

        <!-- 空格 -->
        <module name="WhitespaceAroundCheck"/>

        <!-- 修饰符 -->
        <module name="ModifierOrderCheck"/>

        <!-- 空块 -->
        <module name="EmptyBlockCheck"/>

        <!-- 代码布局 -->
        <module name="OneStatementPerLineCheck"/>
        <module name="MultipleVariableDeclarationsCheck"/>

        <!-- 类型 -->
        <module name="ArrayTypeStyleCheck"/>
        <module name="UpperEllCheck"/>
        <module name="MissingSwitchDefaultCheck"/>
        <module name="FallThroughCheck"/>
        <module name="VisibilityModifierCheck"><property name="ignoreAnnotation" value="true"/></module>

        <!-- 复杂度 -->
        <module name="FinalParametersCheck"/>
        <module name="CyclomaticComplexityCheck"><property name="max" value="15"/></module>
        <module name="NPathComplexityCheck"><property name="max" value="200"/></module>

        <!-- 禁止 -->
        <module name="IllegalInstantiationCheck"/>
        <module name="ExplicitInitializationCheck"/>
        <module name="InnerAssignmentCheck"/>
        <module name="MissingOverrideCheck"/>
    </module>
</module>